# Copy to `.env.local` (Next loads this). Never commit real secrets.

# --- Chat LLM (prefer OpenRouter for $0 prod on Vercel) ---
# Get a key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional pin (default openrouter/free — auto free model):
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_SITE_URL=https://vawcom.com
# OPENROUTER_APP_NAME=VAWCOM Chat
# OPENROUTER_TIMEOUT_MS=45000
# Force provider: openrouter | ollama
# CHAT_PROVIDER=openrouter

# --- Local Ollama (dev / optional fallback when no OpenRouter key) ---
# Install: https://ollama.com
# ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_KEEP_ALIVE=60m
# OLLAMA_TIMEOUT_MS=45000

# Contact form (optional)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
